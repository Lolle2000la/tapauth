# Maintainer: Lolle2000la
pkgbase=tapauth
pkgname=('tapauth')
pkgver=0.1.0
pkgrel=1
arch=('x86_64' 'aarch64')
# Suppress the auto-generated split debug package (makepkg debug option)
options=(!debug)
url="https://github.com/lolle2000la/tapauth"
license=('AGPL-3.0-only')
makedepends=('cargo' 'protobuf' 'clang' 'pam')
source=("$pkgbase-$pkgver.tar.gz::https://github.com/lolle2000la/tapauth/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')
prepare() {
  cd "${srcdir}/${pkgbase}-${pkgver}"
  export CARGO_HOME="${srcdir}/cargo-home"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "${srcdir}/${pkgbase}-${pkgver}"
  export CARGO_HOME="${srcdir}/cargo-home"
  export CARGO_PROFILE_RELEASE_STRIP=true
  cargo build --frozen --workspace --release --locked
}

package_tapauth() {
  pkgdesc="Local smartphone-based authentication framework engine (includes virtual fprintd lock screen bridge)"
  depends=('dbus' 'pam' 'polkit' 'wayland' 'libx11' 'libxcursor' 'libxrandr' 'libxi' 'libxkbcommon' 'hicolor-icon-theme')
  optdepends=(
    'firewalld: for automated firewall port management'
    'iptables: for iptables firewall integration'
    'bluez: for Bluetooth Low Energy (BLE) transport'
  )
  conflicts=('tapauth-git' 'tapauth-fprintd' 'tapauth-fprintd-git')
  # tapauth-fprintd / -git were merged into the base package: the virtual
  # fprintd bridge is enabled by default. NOTE: no conflict with real
  # fprintd, and no D-Bus activation file is shipped (fprintd's own
  # /usr/share/dbus-1/system-services/net.reactivated.Fprint.service stays
  # untouched; a second activation file for the same Name= cannot win —
  # dbus-daemon keeps the first-sorted file and dbus-broker ignores files
  # not named after the bus name). tapauthd is a systemd-managed daemon
  # that owns the bus name while it runs; the shipped system.d policy file
  # authorizes that. Real fprintd stays functional whenever the bridge is
  # disabled (enable_fprintd_bridge = false) or tapauthd is stopped.
  replaces=('tapauth-fprintd' 'tapauth-fprintd-git')
  install=tapauth.install

  cd "${srcdir}/${pkgbase}-${pkgver}"
  install -dm0755 "${pkgdir}/etc/tapauth"
  # Ship only config.toml.example: the daemon runs on defaults without a
  # config file, and post_install seeds /etc/tapauth/config.toml from the
  # example when it is missing. Shipping a live config would cause
  # .pacnew churn on every upgrade.
  install -Dm0644 config.toml.example "${pkgdir}/etc/tapauth/config.toml.example"
  install -Dm0755 target/release/tapauthd "${pkgdir}/usr/bin/tapauthd"
  install -Dm0755 target/release/tapauth-config "${pkgdir}/usr/bin/tapauth-config"
  install -Dm0755 target/release/tapauth-ipc-cli "${pkgdir}/usr/bin/tapauth-ipc-cli"
  install -Dm0755 target/release/libclient_pam.so "${pkgdir}/usr/lib/security/pam_tapauth.so"

  install -Dm0644 systemd/tapauthd.service "${pkgdir}/usr/lib/systemd/system/tapauthd.service"
  install -Dm0644 systemd/tapauthd.socket "${pkgdir}/usr/lib/systemd/system/tapauthd.socket"
  install -Dm0644 systemd/polkit-agent-helper@.service.d/tapauth.conf "${pkgdir}/usr/lib/systemd/system/polkit-agent-helper@.service.d/tapauth.conf"
  install -Dm0644 packaging/90-tapauthd.preset "${pkgdir}/usr/lib/systemd/system-preset/90-tapauthd.preset"

  install -Dm0644 packaging/sysusers.conf "${pkgdir}/usr/lib/sysusers.d/tapauth.conf"
  install -Dm0644 packaging/tmpfiles.conf "${pkgdir}/usr/lib/tmpfiles.d/tapauth.conf"

  install -Dm0644 client-config-gui/tapauth-config.desktop "${pkgdir}/usr/share/applications/tapauth-config.desktop"
  install -Dm0644 client-config-gui/assets/tapauth-config.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/tapauth-config.svg"
  install -Dm0644 tapauthd/dev.rourunisen.tapauth.config.admin.policy "${pkgdir}/usr/share/polkit-1/actions/dev.rourunisen.tapauth.config.admin.policy"
  install -Dm0644 packaging/50-tapauthd.rules "${pkgdir}/usr/share/polkit-1/rules.d/50-tapauthd.rules"

  # Virtual fprintd D-Bus bridge files (merged from the former
  # tapauth-fprintd subpackage): the bridge is enabled by default, so
  # lock screens and greeters work out of the box. The activation file is
  # RENAMED (net.reactivated.Fprint.tapauth.service) so it never collides
  # with real fprintd's own
  # /usr/share/dbus-1/system-services/net.reactivated.Fprint.service.
  # Empirically verified duplicate-Name semantics: dbus-daemon keeps the
  # FIRST-sorted file (with real fprintd installed, its file wins activation
  # while tapauthd is down); dbus-broker ignores files not named after the
  # bus name (our file is inert there). While tapauthd runs it OWNS the
  # name; the file provides on-demand start / crash resilience when no
  # owner exists and fprintd is not installed.
  install -Dm0644 packaging/net.reactivated.Fprint.tapauth.conf "${pkgdir}/usr/share/dbus-1/system.d/net.reactivated.Fprint.tapauth.conf"
  install -Dm0644 packaging/net.reactivated.Fprint.tapauth.service "${pkgdir}/usr/share/dbus-1/system-services/net.reactivated.Fprint.tapauth.service"

  # polkit vendor-drift protection: when the polkit package is upgraded it
  # ships a new /usr/lib/pam.d/polkit-1 vendor file, but our /etc/pam.d/
  # override shadows it forever. The hook re-seeds the override from the
  # new vendor file and re-applies the TapAuth line (only when TapAuth has
  # patched the file before, i.e. the .tapauth-bak marker exists).
  install -Dm0644 packaging/tapauth-polkit-pam.hook "${pkgdir}/usr/share/libalpm/hooks/tapauth-polkit-pam.hook"
  install -Dm0755 packaging/tapauth-polkit-pam.sh "${pkgdir}/usr/share/libalpm/scripts/tapauth-polkit-pam"

  install -Dm0644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
