#!/bin/sh
set -e
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
	if command -v pam-auth-update >/dev/null 2>&1; then
		pam-auth-update --package
	fi
fi
if [ "$1" = "purge" ]; then
	# dpkg has already removed the shipped tmpfiles fragment by the time this
	# runs, so `systemd-tmpfiles --remove` cannot find it. Remove the managed
	# runtime/state directories directly so purge leaves nothing behind.
	systemd-tmpfiles --remove /usr/lib/tmpfiles.d/tapauth.conf 2>/dev/null || true
	rm -rf -- /var/lib/tapauth /var/log/tapauth /run/tapauthd
	# The runtime config is generated by tmpfiles, not shipped as a dpkg
	# conffile, so dpkg will not remove it. Purge must: it wipes the pairing
	# state (the CSK) too, and keeping a config for pairings whose keys are gone
	# is inconsistent. Unrelated files an admin placed here are preserved, so
	# the directory is only removed if that leaves it empty.
	rm -f -- /etc/tapauth/config.toml
	rmdir --ignore-fail-on-non-empty /etc/tapauth 2>/dev/null || true
fi
#DEBHELPER#
exit 0
