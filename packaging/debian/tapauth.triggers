# PAM vendor-drift protection: TapAuth patches /etc/pam.d/{sudo,su,polkit-1},
# whose vendored originals are owned by other packages (sudo, util-linux,
# policykit-1/polkitd). Depending on the distro/release the vendor stack
# lives in /usr/lib/pam.d (with our /etc/pam.d override shadowing it) or is
# the /etc/pam.d/<service> file itself (replaced on upgrade, dropping our
# line). These triggers make dpkg re-run this package's postinst
# ("triggered" state) whenever the vendor path changes, so the override is
# re-seeded from the new vendor file and the TapAuth line re-applied — but
# only when the .tapauth-bak marker shows TapAuth patched that file before,
# and only when the line is missing (idempotent). See
# packaging/debian/tapauth.postinst.
interest-noawait /etc/pam.d/sudo
interest-noawait /etc/pam.d/su
interest-noawait /etc/pam.d/polkit-1
interest-noawait /usr/lib/pam.d/sudo
interest-noawait /usr/lib/pam.d/su
interest-noawait /usr/lib/pam.d/polkit-1
