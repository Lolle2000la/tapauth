# Maintainer: Lolle2000la
pkgbase=tapauth-git
pkgname=('tapauth-git' 'tapauth-fprintd-emulation-git')
pkgver=0.10.0.r14.g1e0eb73
pkgrel=1
arch=('x86_64' 'aarch64')
# Suppress the auto-generated split debug package (makepkg debug option)
options=(!debug)
url="https://github.com/lolle2000la/tapauth"
license=('AGPL-3.0-only')
makedepends=('cargo' 'protobuf' 'clang' 'git' 'pam')
source=("tapauth::git+https://github.com/lolle2000la/tapauth.git#branch=main")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/tapauth"
  local desc
  if desc=$(git describe --long --tags 2>/dev/null); then
    echo "$desc" | sed -E 's/^v//;s/-([0-9]+)-g([0-9a-f]+)$/.r\1.g\2/;s/-/_/g'
  else
    local base
    base=$(git tag --sort=-version:refname 2>/dev/null | grep -E '^v[0-9]' | head -1 | sed 's/^v//')
    printf "%s.r%s.%s" "${base:-0.0.0}" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
  fi
}

prepare() {
  cd "${srcdir}/tapauth"
  export CARGO_HOME="${srcdir}/cargo-home"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "${srcdir}/tapauth"
  export CARGO_HOME="${srcdir}/cargo-home"
  export CARGO_PROFILE_RELEASE_STRIP=true
  cargo build --frozen --workspace --release --locked
  # Second, opt-in client-pam build for the tapauth-fprintd-emulation-git
  # split package. A separate target dir (target/fprintd-emulation) keeps it
  # from clobbering the base target/release/libclient_pam.so that is
  # installed as pam_tapauth.so.
  cargo build --frozen -p client-pam --release --locked \
    --features replace-fprintd-pam --target-dir target/fprintd-emulation
}

package_tapauth-git() {
  pkgdesc="Local smartphone-based authentication framework engine (Development/Git version; includes virtual fprintd lock screen bridge)"
  depends=('dbus' 'pam' 'polkit' 'wayland' 'libx11' 'libxcursor' 'libxrandr' 'libxi' 'libxkbcommon' 'hicolor-icon-theme')
  optdepends=(
    'firewalld: for automated firewall port management'
    'iptables: for iptables firewall integration'
    'bluez: for Bluetooth Low Energy (BLE) transport'
  )
  provides=("tapauth=${pkgver}")
  conflicts=('tapauth' 'tapauth-fprintd' 'tapauth-fprintd-git')
  # tapauth-fprintd(-git) was merged into the base package. NOTE: no conflict
  # with real fprintd and no D-Bus activation file (dbus-daemon and dbus-broker
  # only activate files named exactly after the bus name, so a renamed file
  # would be inert; availability comes from systemd, not D-Bus activation). The
  # base package ships only the D-Bus policy file and no emulation marker, so
  # the virtual bridge is off by default.
  replaces=('tapauth-fprintd' 'tapauth-fprintd-git')
  install=tapauth-git.install

  cd "${srcdir}/tapauth"
  install -dm0755 "${pkgdir}/etc/tapauth"
  # Ship only config.toml.example: the daemon runs on defaults without a
  # config file, and post_install seeds /etc/tapauth/config.toml from the
  # example when it is missing (avoids .pacnew churn).
  install -Dm0644 config.toml.example "${pkgdir}/etc/tapauth/config.toml.example"
  # NOTE: tapauth-ipc-cli is a testing-only admin tool and is deliberately NOT
  # installed/shipped here. The E2E harness builds it from the workspace.
  install -Dm0755 target/release/tapauthd "${pkgdir}/usr/bin/tapauthd"
  install -Dm0755 target/release/tapauth-config "${pkgdir}/usr/bin/tapauth-config"
  install -Dm0755 target/release/libclient_pam.so "${pkgdir}/usr/lib/security/pam_tapauth.so"

  install -Dm0644 systemd/tapauthd.service "${pkgdir}/usr/lib/systemd/system/tapauthd.service"
  install -Dm0644 systemd/tapauthd.socket "${pkgdir}/usr/lib/systemd/system/tapauthd.socket"
  install -Dm0644 systemd/polkit-agent-helper@.service.d/tapauth.conf "${pkgdir}/usr/lib/systemd/system/polkit-agent-helper@.service.d/tapauth.conf"
  install -Dm0644 packaging/90-tapauthd.preset "${pkgdir}/usr/lib/systemd/system-preset/90-tapauthd.preset"

  install -Dm0644 packaging/sysusers.conf "${pkgdir}/usr/lib/sysusers.d/tapauth.conf"
  install -Dm0644 packaging/tmpfiles.conf "${pkgdir}/usr/lib/tmpfiles.d/tapauth.conf"

  install -Dm0644 client-config-gui/tapauth-config.desktop "${pkgdir}/usr/share/applications/tapauth-config.desktop"
  install -Dm0644 client-config-gui/assets/tapauth-config.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/tapauth-config.svg"
  install -Dm0644 tapauthd/dev.rourunisen.tapauth.config.admin.policy "${pkgdir}/usr/share/polkit-1/actions/dev.rourunisen.tapauth.config.admin.policy"
  install -Dm0644 packaging/50-tapauthd.rules "${pkgdir}/usr/share/polkit-1/rules.d/50-tapauthd.rules"

  # Virtual fprintd D-Bus bridge: only the policy file ships in the base
  # package (functionally required so tapauthd may own the bus name when the
  # bridge is enabled). No D-Bus activation file; see packaging/arch/PKGBUILD.
  install -Dm0644 packaging/net.reactivated.Fprint.tapauth.conf "${pkgdir}/usr/share/dbus-1/system.d/net.reactivated.Fprint.tapauth.conf"

  # polkit vendor-drift protection (see packaging/arch/PKGBUILD comment).
  install -Dm0644 packaging/tapauth-polkit-pam.hook "${pkgdir}/usr/share/libalpm/hooks/tapauth-polkit-pam.hook"
  install -Dm0755 packaging/tapauth-polkit-pam.sh "${pkgdir}/usr/share/libalpm/scripts/tapauth-polkit-pam"

  install -Dm0644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

package_tapauth-fprintd-emulation-git() {
  pkgdesc="Optional fprintd PAM emulation for TapAuth (Development/Git version; installs pam_fprintd.so)"
  depends=('tapauth-git')
  # The Arch fprintd package is monolithic (daemon + PAM module), so the
  # emulation split package replaces it wholesale. The base tapauth-git
  # package is deliberately left non-conflicting with fprintd.
  #
  # Deliberately NO provides=('fprintd'): a package that both provides and
  # conflicts with the same name has its conflict satisfied by its own
  # provide, so pacman would NOT remove the real fprintd. Without the
  # provide, conflicts forces the user to confirm the swap; replaces covers
  # the sysupgrade path.
  conflicts=('fprintd')
  replaces=('fprintd')
  # Dedicated scriptlet: `install=` is per-package (verified with
  # `makepkg --printsrcinfo`), so this subpackage gets its own tiny .install
  # instead of sharing tapauth-git.install, whose pre_remove is destructive.
  install=tapauth-fprintd-emulation-git.install

  cd "${srcdir}/tapauth"
  # Same client-pam crate as the base package, built with
  # replace-fprintd-pam into a separate target dir and installed under
  # fprintd's module name.
  install -Dm0755 target/fprintd-emulation/release/libclient_pam.so \
    "${pkgdir}/usr/lib/security/pam_fprintd.so"

  # Marker that flips the daemon's tri-state enable_fprintd_bridge default to
  # "on". Owned by this split package only.
  install -Dm0644 /dev/null "${pkgdir}/usr/share/tapauth/fprintd-emulation.enabled"

  install -Dm0644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
