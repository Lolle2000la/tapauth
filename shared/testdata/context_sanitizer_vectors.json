{
  "about": "Canonical vectors for the context-string sanitizer. Read by the Rust test `context_sanitizer_vectors_are_honoured` in shared/src/protocol/messages.rs (via include_str!) and by ContextSanitizerTest.kt in server-android (same path, resolved from the Gradle test working directory server-android/app). Both implementations must reproduce every expected value: add a case here, never in one suite only.",
  "cases": [
    {
      "name": "tab and newline collapse to one space",
      "input": "sudo\tapt\nupdate",
      "max_bytes": 128,
      "expected": "sudo apt update"
    },
    {
      "name": "whitespace runs collapse and both ends trim",
      "input": "  a \t\n  b  ",
      "max_bytes": 128,
      "expected": "a b"
    },
    {
      "name": "CSI colour codes are removed as a unit",
      "input": "\u001b[31mroot\u001b[0m",
      "max_bytes": 128,
      "expected": "root"
    },
    {
      "name": "non-breaking space collapses",
      "input": "a\u00a0b",
      "max_bytes": 128,
      "expected": "a b"
    },
    {
      "name": "unterminated CSI is removed to end of input",
      "input": "x\u001b[31",
      "max_bytes": 128,
      "expected": "x"
    },
    {
      "name": "OSC terminated by BEL is removed",
      "input": "a\u001b]0;evil\u0007b",
      "max_bytes": 128,
      "expected": "ab"
    },
    {
      "name": "OSC terminated by ESC backslash is removed",
      "input": "a\u001b]8;;http://evil.example\u001b\\b",
      "max_bytes": 128,
      "expected": "ab"
    },
    {
      "name": "unterminated OSC is removed to end of input",
      "input": "a\u001b]0;evil",
      "max_bytes": 128,
      "expected": "a"
    },
    {
      "name": "lone ESC is dropped and the next byte filtered normally",
      "input": "a\u001bb",
      "max_bytes": 128,
      "expected": "ab"
    },
    {
      "name": "lone ESC at end of input is dropped",
      "input": "ab\u001b",
      "max_bytes": 128,
      "expected": "ab"
    },
    {
      "name": "CSI with parameters is removed",
      "input": "\u001b[1;31;48;5;196mred",
      "max_bytes": 128,
      "expected": "red"
    },
    {
      "name": "CSI with an intermediate byte is removed",
      "input": "x\u001b[1 qb",
      "max_bytes": 128,
      "expected": "xb"
    },
    {
      "name": "right-to-left override cannot reorder the prompt",
      "input": "safe\u202eevil\u202e.exe",
      "max_bytes": 128,
      "expected": "safeevil.exe"
    },
    {
      "name": "C1 NEL is whitespace, not a control to delete",
      "input": "a\u0085b",
      "max_bytes": 128,
      "expected": "a b"
    },
    {
      "name": "whitespace-only input becomes empty",
      "input": " \t\n\u00a0\u3000 ",
      "max_bytes": 128,
      "expected": ""
    },
    {
      "name": "empty input",
      "input": "",
      "max_bytes": 128,
      "expected": ""
    },
    {
      "name": "nothing to truncate",
      "input": "sudo",
      "max_bytes": 128,
      "expected": "sudo"
    },
